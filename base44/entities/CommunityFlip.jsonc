{
  "name": "CommunityFlip",
  "type": "object",
  "properties": {
    "item_name": {
      "type": "string",
      "description": "Name of the item"
    },
    "category": {
      "type": "string",
      "enum": [
        "cards",
        "sneakers",
        "clothing",
        "electronics",
        "collectibles",
        "games",
        "technology",
        "vintage",
        "other"
      ],
      "description": "Category of the item"
    },
    "description": {
      "type": "string",
      "description": "Details about the flip opportunity"
    },
    "price": {
      "type": "number",
      "description": "Asking price or estimated value"
    },
    "location": {
      "type": "string",
      "description": "Location of the item"
    },
    "image_url": {
      "type": "string",
      "description": "Image of the item"
    },
    "posted_by": {
      "type": "string",
      "description": "Email of user who posted"
    },
    "posted_by_name": {
      "type": "string",
      "description": "Name of user who posted"
    },
    "is_poster_pro": {
      "type": "boolean",
      "default": false,
      "description": "Whether the poster had Pro at the time of posting"
    },
    "interested_users": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of user emails who are interested"
    }
  },
  "required": [
    "item_name",
    "category",
    "price",
    "posted_by",
    "posted_by_name"
  ]
}