{
  "name": "CommunityFlip",
  "type": "object",
  "properties": {
    "item_name": {
      "type": "string",
      "description": "Name of the item"
    },
    "category": {
      "type": "string",
      "enum": [
        "cards",
        "sneakers",
        "clothing",
        "electronics",
        "collectibles",
        "games",
        "technology",
        "vintage",
        "other"
      ],
      "description": "Category of the item"
    },
    "description": {
      "type": "string",
      "description": "Details about the flip opportunity"
    },
    "price": {
      "type": "number",
      "description": "Asking price or estimated value"
    },
    "location": {
      "type": "string",
      "description": "Location of the item"
    },
    "image_url": {
      "type": "string",
      "description": "Image of the item"
    },
    "is_ai_generated_image": {
      "type": "boolean",
      "default": false,
      "description": "Whether the image is AI-generated"
    },
    "is_reference_image": {
      "type": "boolean",
      "default": false,
      "description": "Whether the image is a reference image from official sources"
    },
    "is_sold": {
      "type": "boolean",
      "default": false,
      "description": "Whether the listing is marked as sold"
    },
    "posted_by": {
      "type": "string",
      "description": "Email of user who posted"
    },
    "posted_by_name": {
      "type": "string",
      "description": "Name of user who posted"
    },
    "is_poster_pro": {
      "type": "boolean",
      "default": false,
      "description": "Whether the poster had Pro at the time of posting"
    },
    "interested_users": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of user emails who are interested"
    },
    "is_graded": {
      "type": "boolean",
      "default": false,
      "description": "Whether the card is graded"
    },
    "grading_company": {
      "type": "string",
      "enum": [
        "PSA",
        "BGS",
        "CGC",
        "SGC",
        "GMA",
        "HGA",
        "CSG",
        "AGS",
        "other"
      ],
      "description": "Grading company"
    },
    "grade": {
      "type": "string",
      "description": "Grade value (e.g. 9, 9.5, 10, Gem Mint)"
    },
    "cert_number": {
      "type": "string",
      "description": "Grading certificate/serial number"
    }
  },
  "required": [
    "item_name",
    "category",
    "price",
    "posted_by",
    "posted_by_name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": true,
    "update": true,
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}