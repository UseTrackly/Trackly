{
  "name": "Message",
  "type": "object",
  "properties": {
    "community_flip_id": {
      "type": "string",
      "description": "ID of the community flip being discussed"
    },
    "sender_email": {
      "type": "string",
      "description": "Email of message sender"
    },
    "sender_name": {
      "type": "string",
      "description": "Name of message sender"
    },
    "recipient_email": {
      "type": "string",
      "description": "Email of message recipient"
    },
    "content": {
      "type": "string",
      "description": "Message content"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether message has been read"
    }
  },
  "required": [
    "community_flip_id",
    "sender_email",
    "sender_name",
    "recipient_email",
    "content"
  ]
}