{
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "description": "User's display name in the community"
    },
    "bio": {
      "type": "string",
      "description": "User bio"
    },
    "location": {
      "type": "string",
      "description": "User location"
    },
    "profile_picture": {
      "type": "string",
      "description": "Profile picture URL"
    },
    "selected_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Selected business categories"
    },
    "currency": {
      "type": "string",
      "default": "USD",
      "description": "Preferred currency"
    },
    "notifications_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Email notifications enabled"
    },
    "push_notifications": {
      "type": "boolean",
      "default": false,
      "description": "Push notifications enabled"
    },
    "weekly_summary": {
      "type": "boolean",
      "default": true,
      "description": "Weekly summary emails"
    },
    "is_pro": {
      "type": "boolean",
      "default": false,
      "description": "Pro subscription status"
    },
    "pro_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Pro subscription expiry date"
    }
  },
  "name": "User",
  "required": [
    "username",
    "bio",
    "location",
    "profile_picture",
    "selected_categories",
    "pro_expires_at"
  ]
}