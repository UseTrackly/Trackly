{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user (unique key)"
    },
    "display_name": {
      "type": "string",
      "description": "User's chosen display name"
    },
    "username": {
      "type": "string",
      "description": "User's chosen username"
    },
    "bio": {
      "type": "string",
      "description": "User bio"
    },
    "location": {
      "type": "string",
      "description": "User location"
    },
    "avatar_url": {
      "type": "string",
      "description": "Profile picture URL"
    },
    "banner_url": {
      "type": "string",
      "description": "Profile header/banner image URL"
    },
    "song_name": {
      "type": "string",
      "description": "Optional profile song name displayed on profile"
    },
    "blocked_users": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of blocked user emails"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}