{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user (unique key)"
    },
    "display_name": {
      "type": "string",
      "description": "User's chosen display name"
    },
    "username": {
      "type": "string",
      "description": "User's chosen username"
    },
    "bio": {
      "type": "string",
      "description": "User bio"
    },
    "location": {
      "type": "string",
      "description": "User location"
    },
    "avatar_url": {
      "type": "string",
      "description": "Profile picture URL"
    },
    "banner_url": {
      "type": "string",
      "description": "Profile header/banner image URL"
    },
    "song_name": {
      "type": "string",
      "description": "Song title and artist shown on profile (e.g. Money Longer \u2013 Lil Uzi Vert)"
    },
    "song_preview_url": {
      "type": "string",
      "description": "Direct audio preview URL (mp3/m4a) or YouTube/Spotify/Apple Music link for profile song"
    },
    "followers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of user emails who follow this profile"
    },
    "following": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of user emails this profile follows"
    },
    "blocked_users": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of blocked user emails"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}